{
  "openapi": "3.1.0",
  "info": {
    "title": "Ki-67 Proliferation Indexer API",
    "version": "3.0.1",
    "description": "Count-based Ki-67 arithmetic and a separately scoped legacy mock audit workflow. Not a validated clinical grading service."
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Serve local static calculator",
        "responses": {
          "200": {
            "description": "HTML calculator"
          }
        }
      }
    },
    "/api/ki67": {
      "post": {
        "summary": "Compute positive / total tumour nucleus percentage",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "positive_cells",
                  "total_cells"
                ],
                "properties": {
                  "positive_cells": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total_cells": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Count ratio and raw counts"
          },
          "422": {
            "description": "Invalid or inconsistent count input"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Service metadata"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory generic audit counters (JSON)",
        "responses": {
          "200": {
            "description": "Counts"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Process legacy generic audit task (not clinical grading)",
        "responses": {
          "200": {
            "description": "Generic demonstration dossier"
          },
          "422": {
            "description": "Rejected patient identifier"
          },
          "503": {
            "description": "Audit signing unavailable"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock response, no LLM analysis",
        "responses": {
          "200": {
            "description": "Mock response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "In-memory HMAC chain metadata",
        "responses": {
          "200": {
            "description": "Audit metadata and integrity verification"
          }
        }
      }
    }
  }
}
