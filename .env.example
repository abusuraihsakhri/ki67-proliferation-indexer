# Ki67 Proliferation Indexer - Environment Configuration
# Copy this file to .env and fill in your values.

# REQUIRED: Secret key for HMAC-SHA256 audit trail signing.
# Generate a secure random key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=

# Model provider for LLM-based chat (mock, ollama, claude, openai)
MODEL_PROVIDER=mock

# FastAPI server configuration
HOST=127.0.0.1
PORT=8000
